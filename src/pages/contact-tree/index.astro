---
import '../../styles/global.css';

import BrandLogo from '../../components/brand/BrandLogo.astro';
import WhatsAppButton from '../../components/common/WhatsAppButton.astro';
import ContactIcon from '../../components/contact/ContactIcon.astro';
import SeoHead from '../../components/seo/SeoHead.astro';
import { contactConfig } from '../../data/contact';
import { SITE_DESCRIPTION, SITE_NAME } from '../../utils/site';

const title = 'Contact & Official Links';
const description =
  'Call, email, visit, or follow Momen Fawzy Interior Design Studio through its verified contact channels.';
const currentYear = new Date().getFullYear();
const landline = contactConfig.phones.find((phone) => phone.id === 'landline')!;
const mobile = contactConfig.phones.find((phone) => phone.id === 'mobile')!;
const primaryEmail = contactConfig.emails.find((email) => email.isPrimary)!;
const website = contactConfig.socials.find((social) => social.id === 'website')!;
const websiteLabel = new URL(website.url).hostname.replace(/^www\./, '');
const socialProfiles = contactConfig.socials.filter((social) => social.id !== 'website');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead {title} {description} noindex />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="contact-tree-page">
    <a class="skip-link" href="#main-content">
      Skip to contact links
    </a>

    <main id="main-content" class="contact-tree-shell">
      <header class="contact-tree-identity">
        <a href={website.url} class="inline-flex" aria-label={`${SITE_NAME}, website`}>
          <BrandLogo size="contactTree" priority />
        </a>
        <p class="mt-5 max-w-[34rem] text-sm leading-7 text-muted">{SITE_DESCRIPTION}</p>
      </header>

      <section aria-labelledby="direct-contact-title" class="mt-8">
        <div class="contact-tree-section-heading">
          <h1 id="direct-contact-title">Contact the Studio</h1>
          <span aria-hidden="true">01</span>
        </div>

        <div class="mt-3 grid gap-2.5">
          <a
            class="contact-tree-link"
            href={landline.href}
            aria-label={`Call Main Office at ${landline.display}`}
          >
            <span class="contact-tree-icon">
              <ContactIcon name="phone" class="size-5" />
            </span>
            <span class="min-w-0">
              <span class="contact-tree-label">Call Main Office</span>
              <span class="contact-tree-detail">{landline.display}</span>
            </span>
            <span class="contact-tree-arrow" aria-hidden="true">
              →
            </span>
          </a>

          <a
            class="contact-tree-link"
            href={mobile.href}
            aria-label={`Call Mobile at ${mobile.display}`}
          >
            <span class="contact-tree-icon">
              <ContactIcon name="mobile" class="size-5" />
            </span>
            <span class="min-w-0">
              <span class="contact-tree-label">Call Mobile</span>
              <span class="contact-tree-detail">{mobile.display}</span>
            </span>
            <span class="contact-tree-arrow" aria-hidden="true">
              →
            </span>
          </a>

          <a
            class="contact-tree-link"
            href={primaryEmail.href}
            aria-label={`Email ${primaryEmail.address}`}
          >
            <span class="contact-tree-icon">
              <ContactIcon name="email" class="size-5" />
            </span>
            <span class="min-w-0">
              <span class="contact-tree-label">Send Email</span>
              <span class="contact-tree-detail break-all">{primaryEmail.address}</span>
            </span>
            <span class="contact-tree-arrow" aria-hidden="true">
              →
            </span>
          </a>

          <a
            class="contact-tree-link"
            href={contactConfig.office.directionsUrl}
            target="_blank"
            rel="noreferrer"
            aria-label="Get directions to the Main Office in Google Maps (opens in a new tab)"
          >
            <span class="contact-tree-icon">
              <ContactIcon name="location" class="size-5" />
            </span>
            <span class="min-w-0">
              <span class="contact-tree-label">Get Directions</span>
              <span class="contact-tree-detail">{contactConfig.office.address}</span>
            </span>
            <span class="contact-tree-arrow" aria-hidden="true">
              ↗
            </span>
          </a>

          <a
            class="contact-tree-link"
            href={website.url}
            target="_blank"
            rel="noreferrer"
            aria-label="Visit the Momen Fawzy Interior Design Studio website (opens in a new tab)"
          >
            <span class="contact-tree-icon">
              <ContactIcon name="external" class="size-5" />
            </span>
            <span class="min-w-0">
              <span class="contact-tree-label">Visit Main Website</span>
              <span class="contact-tree-detail">{websiteLabel}</span>
            </span>
            <span class="contact-tree-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </div>
      </section>

      <section aria-labelledby="social-links-title" class="mt-8">
        <div class="contact-tree-section-heading">
          <h2 id="social-links-title">Follow the Studio</h2>
          <span aria-hidden="true">02</span>
        </div>

        <div class="mt-3 grid gap-2.5">
          {socialProfiles.map((social) => (
            <a
              class="contact-tree-link"
              href={social.url}
              target="_blank"
              rel="noreferrer"
              aria-label={`Follow the studio on ${social.label} (opens in a new tab)`}
            >
              <span class="contact-tree-icon">
                <ContactIcon
                  name={
                    social.id === 'facebook'
                      ? 'facebook'
                      : social.id === 'instagram'
                        ? 'instagram'
                        : 'youtube'
                  }
                  class="size-5"
                />
              </span>
              <span class="min-w-0">
                <span class="contact-tree-label">{social.label}</span>
                <span class="contact-tree-detail">{social.description}</span>
              </span>
              <span class="contact-tree-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          ))}
        </div>
      </section>

      <footer class="contact-tree-footer">
        <p>
          © {currentYear} {SITE_NAME}
        </p>
        <a href={website.url} target="_blank" rel="noreferrer">
          {websiteLabel} ↗
        </a>
      </footer>
    </main>
    <WhatsAppButton />
  </body>
</html>

<style>
  :global(.contact-tree-page) {
    min-width: 20rem;
    min-height: 100svh;
    background: var(--brand-color-canvas);
  }

  .contact-tree-shell {
    width: min(100%, 44rem);
    margin-inline: auto;
    padding: max(2rem, env(safe-area-inset-top)) max(1.25rem, env(safe-area-inset-right))
      max(2rem, env(safe-area-inset-bottom)) max(1.25rem, env(safe-area-inset-left));
  }

  .contact-tree-identity {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--brand-color-border);
  }

  .contact-tree-section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--brand-color-accent);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .contact-tree-section-heading h1,
  .contact-tree-section-heading h2 {
    font-family: var(--brand-font-body);
    font-size: inherit;
    font-weight: inherit;
  }

  .contact-tree-link {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: 4.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--brand-color-border);
    background: var(--brand-color-surface);
    transition:
      border-color var(--brand-duration-fast) var(--brand-ease-standard),
      color var(--brand-duration-fast) var(--brand-ease-standard),
      transform var(--brand-duration-fast) var(--brand-ease-standard);
  }

  .contact-tree-link:hover {
    transform: translateY(-1px);
    border-color: var(--brand-color-accent);
  }

  .contact-tree-link:focus-visible {
    border-color: var(--brand-color-accent);
  }

  .contact-tree-icon {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--brand-color-border);
    color: var(--brand-color-accent);
    transition: border-color var(--brand-duration-fast) var(--brand-ease-standard);
  }

  .contact-tree-link:hover .contact-tree-icon {
    border-color: var(--brand-color-accent);
  }

  .contact-tree-label,
  .contact-tree-detail {
    display: block;
  }

  .contact-tree-label {
    color: var(--brand-color-text);
    font-size: 0.875rem;
    font-weight: 650;
  }

  .contact-tree-detail {
    margin-top: 0.1rem;
    color: var(--brand-color-text-muted);
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .contact-tree-arrow {
    color: var(--brand-color-accent);
    font-size: 1rem;
    transition: transform var(--brand-duration-fast) var(--brand-ease-standard);
  }

  .contact-tree-link:hover .contact-tree-arrow {
    transform: translateX(0.2rem);
  }

  .contact-tree-footer {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--brand-color-border);
    color: var(--brand-color-text-muted);
    font-size: 0.6rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-tree-footer a {
    width: fit-content;
    color: var(--brand-color-accent);
  }

  @media (min-width: 40rem) {
    .contact-tree-shell {
      padding-top: max(3.5rem, env(safe-area-inset-top));
      padding-bottom: max(3.5rem, env(safe-area-inset-bottom));
    }

    .contact-tree-link {
      min-height: 5.25rem;
      padding-inline: 1.25rem;
    }

    .contact-tree-footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>

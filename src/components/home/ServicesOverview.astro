---
import { Image } from 'astro:assets';

import serviceImage from '../../assets/images/projects/valorie-residence/11-bedroom-dressing.jpg';
import { activeServices } from '../../data/services';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';

const featuredServiceSlugs = [
  'interior-design-visualization',
  'fit-out-integrated-systems',
  'project-delivery-aftercare',
] as const;
const services = featuredServiceSlugs.map((slug) =>
  activeServices.find((service) => service.slug === slug)!,
);
---

<Section
  id="services-overview"
  labelledby="services-overview-title"
  tone="surface"
  class="border-b border-border"
>
  <Container width="wide">
    <div class="grid gap-14 lg:grid-cols-[0.78fr_1.22fr] lg:gap-20 xl:gap-28">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow">Our Services</p>
        <h2
          id="services-overview-title"
          class="mt-5 font-display text-[clamp(3rem,5vw,5.5rem)] leading-[0.9] tracking-[-0.035em]"
        >
          End-to-End Interior Solutions
        </h2>
        <p class="mt-7 max-w-lg text-base leading-8 text-muted">
          A single, considered process connecting concept, coordination, execution, and on-site
          quality.
        </p>
        <div class="group relative mt-10 aspect-[5/4] overflow-hidden">
          <Image
            src={serviceImage}
            alt="Contemporary bedroom and dressing room designed by Momen Fawzy Interior Design"
            widths={[640, 960]}
            sizes="(max-width: 1023px) 100vw, 38vw"
            loading="lazy"
            quality={82}
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent"></div>
          <p class="absolute right-5 bottom-5 left-5 text-[0.62rem] tracking-[0.17em] text-white/75 uppercase">
            Material, light, proportion, and detail
          </p>
        </div>
      </div>

      <ol class="border-t border-border" role="list">
        {services.map((service, index) => (
          <li class="border-b border-border">
            <a
              href={`/services/#${service.slug}`}
              class="service-row group grid gap-5 py-10 sm:grid-cols-[4rem_1fr_auto] sm:items-start sm:gap-8 lg:py-14"
              aria-label={`Learn more about ${service.title}`}
            >
              <span class="pt-2 text-xs tracking-[0.16em] text-accent">0{index + 1}</span>
              <div>
                <h3 class="font-display text-[clamp(2.2rem,4vw,4.2rem)] leading-none transition-colors duration-300 group-hover:text-accent">
                  {service.title}
                </h3>
                <p class="mt-5 max-w-xl text-sm leading-7 text-muted sm:text-base">
                  {service.description}
                </p>
              </div>
              <span
                class="mt-2 text-xl text-accent transition-transform duration-300 group-hover:translate-x-2"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </Container>
</Section>

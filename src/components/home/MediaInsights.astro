---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

import fallbackImage from '../../assets/images/projects/city-edge-alamein-studio/01-cover.jpg';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';

interface Props {
  items: CollectionEntry<'media'>[];
}

const { items } = Astro.props;
const featured = items[0];
---

<Section id="media-insights" labelledby="media-insights-title" class="border-b border-border">
  <Container width="wide">
    <div class="grid gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:items-end lg:gap-20">
      <div class="lg:pb-8">
        <p class="eyebrow">Media &amp; Insights</p>
        <h2
          id="media-insights-title"
          class="mt-5 font-display text-[clamp(3rem,5vw,5.5rem)] leading-[0.9] tracking-[-0.035em]"
        >
          Perspectives on Design &amp; Execution
        </h2>
        <p class="mt-7 max-w-lg text-base leading-8 text-muted">
          Project tours, site execution, finishing details, and practical perspectives from the
          studio.
        </p>
        <a
          href="/media-center/"
          class="editorial-link mt-9 inline-flex items-center gap-3 text-xs font-bold tracking-[0.16em] uppercase"
        >
          Visit media center <span aria-hidden="true">→</span>
        </a>
      </div>

      {featured ? (
        <a href={featured.data.externalUrl ?? '/media-center/'} class="group block">
          <div class="relative aspect-[16/10] overflow-hidden bg-surface">
            {featured.data.thumbnail && (
              <Image
                src={featured.data.thumbnail}
                alt={featured.data.thumbnailAlt ?? ''}
                widths={[720, 1080, 1440]}
                sizes="(max-width: 1023px) 100vw, 62vw"
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
              />
            )}
            <span
              class="absolute bottom-6 left-6 grid size-16 place-items-center rounded-full border border-white/40 bg-black/35 text-accent backdrop-blur-sm"
              aria-hidden="true"
            >
              ▶
            </span>
          </div>
          <h3 class="mt-5 font-display text-3xl">{featured.data.title}</h3>
          <p class="mt-2 text-sm leading-7 text-muted">{featured.data.summary}</p>
        </a>
      ) : (
        <div class="group">
          <div class="relative aspect-[16/10] overflow-hidden bg-surface">
            <Image
              src={fallbackImage}
              alt="Contemporary residential interior by Momen Fawzy Interior Design"
              widths={[720, 1080, 1440, 1800]}
              sizes="(max-width: 1023px) 100vw, 62vw"
              loading="lazy"
              quality={84}
              class="h-full w-full object-cover transition-transform duration-700 ease-[var(--brand-ease-emphasized)] group-hover:scale-[1.02]"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/5 to-black/15"></div>
            <div class="absolute right-7 bottom-7 left-7">
              <p class="font-display text-2xl text-white sm:text-3xl">Explore the media center</p>
            </div>
          </div>
        </div>
      )}
    </div>
  </Container>
</Section>

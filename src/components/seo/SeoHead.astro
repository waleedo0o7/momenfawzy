---
import { SITE_NAME } from '../../utils/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  image?: string;
}

const { title, description, noindex = false, image } = Astro.props;
const pageTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const imageUrl = image && Astro.site ? new URL(image, Astro.site) : undefined;
---

<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
{imageUrl && <meta property="og:image" content={imageUrl} />}
<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}

<title>{pageTitle}</title>

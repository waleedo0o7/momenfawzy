---
import { contactConfig } from '../../data/contact';
import ContactIcon from '../contact/ContactIcon.astro';

const whatsappUrl = contactConfig.whatsappUrl ? new URL(contactConfig.whatsappUrl) : null;

whatsappUrl?.searchParams.set(
  'text',
  'Hello Momen Fawzy Interior Design, I would like to discuss a project.',
);
---

{whatsappUrl && (
  <a
    href={whatsappUrl.toString()}
    target="_blank"
    rel="noopener noreferrer"
    class="whatsapp-float fixed right-4 z-50 grid size-12 place-items-center rounded-full border border-accent/60 bg-canvas text-accent shadow-[0_0.75rem_2.5rem_rgba(0,0,0,0.35)] transition-[color,background-color,border-color,transform] duration-300 hover:-translate-y-1 hover:border-accent hover:bg-accent hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:right-6 sm:size-13"
    aria-label="Contact Momen Fawzy Interior Design on WhatsApp"
    title="Contact us on WhatsApp"
  >
    <ContactIcon name="whatsapp" class="size-5 sm:size-6" />
  </a>
)}

<style>
  .whatsapp-float {
    bottom: max(1rem, env(safe-area-inset-bottom));
  }

  @media (min-width: 640px) {
    .whatsapp-float {
      bottom: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-float {
      transition: none;
    }
  }
</style>

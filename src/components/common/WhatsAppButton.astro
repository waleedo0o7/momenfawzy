---
import whatsappLogo from '../../assets/images/ui/whatsapp-logo.svg';
import { contactConfig } from '../../data/contact';

const whatsappUrl = contactConfig.whatsappUrl ? new URL(contactConfig.whatsappUrl) : null;

whatsappUrl?.searchParams.set(
  'text',
  'Hello Momen Fawzy Interior Design, I would like to discuss a project.',
);
---

{whatsappUrl && (
  <a
    href={whatsappUrl.toString()}
    target="_blank"
    rel="noopener noreferrer"
    class="whatsapp-float fixed right-4 z-50 grid size-11 place-items-center rounded-full bg-transparent drop-shadow-[0_0.5rem_0.75rem_rgba(0,0,0,0.3)] transition-transform duration-300 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#25d366] sm:right-6"
    aria-label="Contact Momen Fawzy Interior Design on WhatsApp"
    title="Contact us on WhatsApp"
  >
    <img
      src={whatsappLogo.src}
      alt=""
      width={40}
      height={40}
      class="size-full object-contain"
      aria-hidden="true"
    />
  </a>
)}

<style>
  .whatsapp-float {
    bottom: max(1rem, env(safe-area-inset-bottom));
  }

  @media (min-width: 640px) {
    .whatsapp-float {
      bottom: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-float {
      transition: none;
    }
  }
</style>

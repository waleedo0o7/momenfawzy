---
import { Image } from 'astro:assets';

import type { ImageMetadata } from 'astro';
import Container from '../ui/Container.astro';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
}

const { image, imageAlt } = Astro.props;
---

<section
  aria-labelledby="services-hero-title"
  class="relative isolate min-h-[45rem] overflow-hidden border-b border-border sm:min-h-[54rem] lg:h-[calc(100svh-5.25rem)] lg:min-h-[50rem] lg:max-h-[64rem]"
>
  <Image
    src={image}
    alt={imageAlt}
    widths={[720, 1080, 1440, 1920]}
    sizes="100vw"
    format="webp"
    quality={88}
    priority
    class="absolute inset-0 -z-30 h-full w-full object-cover object-[57%_center] sm:object-center"
  />
  <div
    class="absolute inset-0 -z-20 bg-[linear-gradient(90deg,rgba(10,11,9,0.97)_0%,rgba(10,11,9,0.88)_38%,rgba(10,11,9,0.42)_72%,rgba(10,11,9,0.22)_100%),linear-gradient(0deg,rgba(10,11,9,0.92)_0%,transparent_58%)]"
    aria-hidden="true"
  ></div>

  <Container
    width="wide"
    class="flex min-h-[45rem] items-end sm:min-h-[54rem] lg:h-full lg:min-h-0"
  >
    <div class="services-hero-copy max-w-[72rem] pb-[clamp(5rem,9vw,8.5rem)] pt-40">
      <p class="eyebrow">Complete Interior Solutions</p>
      <h1
        id="services-hero-title"
        class="mt-7 max-w-[11.5ch] font-display text-[clamp(3.85rem,7.6vw,8.8rem)] leading-[0.82] tracking-[-0.052em]"
      >
        Designed with Vision. <span class="text-accent italic">Delivered with Confidence.</span>
      </h1>
      <div class="mt-9 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <p class="max-w-[42rem] text-[clamp(1.0625rem,1.25vw,1.25rem)] leading-[1.8] text-white/78">
          From the first site visit to final handover and aftercare, we manage every stage with
          clarity, coordination, and close attention to detail.
        </p>
        <a
          href="#services"
          class="editorial-link w-fit text-[0.64rem] font-bold tracking-[0.18em] text-accent uppercase"
        >
          Explore the Services ↓
        </a>
      </div>
    </div>
  </Container>
</section>

<style>
  .services-hero-copy {
    animation: services-hero-in 800ms var(--brand-ease-emphasized) both;
  }

  @keyframes services-hero-in {
    from {
      transform: translateY(1.25rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .services-hero-copy {
      animation: none;
    }
  }
</style>

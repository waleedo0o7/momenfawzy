---
import type { ContactConfig } from '../../data/contact';
import ContactIcon from './ContactIcon.astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';

interface Props {
  contact: ContactConfig;
}

const { contact } = Astro.props;
const primaryEmail = contact.emails.find((email) => email.isPrimary)!;
---

<Section labelledby="contact-inquiry-title" tone="surface" class="border-b border-border">
  <Container width="wide">
    <div class="grid gap-16 lg:grid-cols-12 lg:gap-14 xl:gap-24">
      <div class="lg:col-span-5">
        <p class="eyebrow">Direct Contact</p>
        <h2
          id="contact-inquiry-title"
          class="mt-6 max-w-[11ch] font-display text-[clamp(3.5rem,5.6vw,6.7rem)] leading-[0.86] tracking-[-0.047em]"
        >
          Let's Talk About <span class="text-accent italic">Your Space.</span>
        </h2>
        <p class="mt-8 max-w-[34rem] text-base leading-8 text-muted sm:text-lg">
          Speak directly with the studio, send an inquiry, or visit the Main Office in Alexandria.
        </p>

        <address class="mt-12 border-t border-border not-italic">
          {contact.phones.map((phone) => (
            <a
              href={phone.href}
              class="group flex min-h-24 items-center gap-5 border-b border-border py-5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
            >
              <span class="grid size-11 shrink-0 place-items-center border border-border text-accent transition-colors group-hover:border-accent">
                <ContactIcon name={phone.id === 'landline' ? 'phone' : 'mobile'} class="size-5" />
              </span>
              <span>
                <span class="block text-[0.62rem] font-bold tracking-[0.17em] text-muted uppercase">
                  {phone.label}
                </span>
                <span class="mt-1 block text-lg text-white/88 transition-colors group-hover:text-accent">
                  {phone.display}
                </span>
              </span>
            </a>
          ))}

          <a
            href={primaryEmail.href}
            class="group flex min-h-24 items-center gap-5 border-b border-border py-5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
          >
            <span class="grid size-11 shrink-0 place-items-center border border-border text-accent transition-colors group-hover:border-accent">
              <ContactIcon name="email" class="size-5" />
            </span>
            <span class="min-w-0">
              <span class="block text-[0.62rem] font-bold tracking-[0.17em] text-muted uppercase">
                Main Email
              </span>
              <span class="mt-1 block break-all text-lg text-white/88 transition-colors group-hover:text-accent">
                {primaryEmail.address}
              </span>
            </span>
          </a>

          <div class="flex min-h-28 items-start gap-5 border-b border-border py-6">
            <span class="grid size-11 shrink-0 place-items-center border border-border text-accent">
              <ContactIcon name="location" class="size-5" />
            </span>
            <div>
              <p class="text-[0.62rem] font-bold tracking-[0.17em] text-muted uppercase">
                {contact.office.label}
              </p>
              <p class="mt-2 max-w-[24rem] text-base leading-7 text-white/82">
                {contact.office.address}
              </p>
              <a
                href={contact.office.directionsUrl}
                target="_blank"
                rel="noreferrer"
                class="editorial-link mt-4 inline-flex items-center gap-2 text-[0.65rem] font-bold tracking-[0.15em] text-accent uppercase"
              >
                Open in Google Maps <ContactIcon name="external" class="size-4" />
              </a>
            </div>
          </div>
        </address>
      </div>

      <div class="bg-light px-[clamp(1.35rem,4vw,4rem)] py-[clamp(2.5rem,6vw,5rem)] text-ink lg:col-span-7">
        <p class="text-[0.68rem] font-bold tracking-[0.19em] text-ink-muted uppercase">
          Project Inquiry
        </p>
        <h2 class="mt-5 max-w-[12ch] font-display text-[clamp(3rem,5vw,5.8rem)] leading-[0.88] tracking-[-0.045em]">
          Tell Us About <span class="italic">Your Project.</span>
        </h2>
        <p class="mt-6 max-w-[38rem] text-sm leading-7 text-ink-muted sm:text-base">
          Required fields are marked with an asterisk. Your details will only be used to respond to
          this inquiry.
        </p>

        <form
          class="mt-10"
          data-contact-form
          data-whatsapp-url={contact.whatsappUrl ?? ''}
          data-message-heading={contact.form.whatsappMessageHeading}
          novalidate
        >
          <div class="grid gap-x-6 gap-y-7 sm:grid-cols-2">
            <div class="sm:col-span-1">
              <label class="contact-label" for="contact-name">
                Full Name <span aria-hidden="true">*</span>
              </label>
              <input
                class="contact-control"
                id="contact-name"
                name="name"
                type="text"
                autocomplete="name"
                minlength="2"
                required
                aria-describedby="contact-name-error"
                data-validate
              />
              <p class="contact-error" id="contact-name-error" aria-live="polite"></p>
            </div>

            <div class="sm:col-span-1">
              <label class="contact-label" for="contact-email">
                Email Address <span aria-hidden="true">*</span>
              </label>
              <input
                class="contact-control"
                id="contact-email"
                name="email"
                type="email"
                autocomplete="email"
                required
                aria-describedby="contact-email-error"
                data-validate
              />
              <p class="contact-error" id="contact-email-error" aria-live="polite"></p>
            </div>

            <div class="sm:col-span-1">
              <label class="contact-label" for="contact-phone">
                Phone Number <span aria-hidden="true">*</span>
              </label>
              <input
                class="contact-control"
                id="contact-phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                minlength="7"
                required
                aria-describedby="contact-phone-error"
                data-validate
              />
              <p class="contact-error" id="contact-phone-error" aria-live="polite"></p>
            </div>

            <div class="sm:col-span-1">
              <label class="contact-label" for="contact-location">
                Project Location
              </label>
              <input
                class="contact-control"
                id="contact-location"
                name="projectLocation"
                type="text"
                autocomplete="address-level2"
              />
            </div>

            <div class="sm:col-span-2">
              <label class="contact-label" for="contact-details">
                Project Details <span aria-hidden="true">*</span>
              </label>
              <textarea
                class="contact-control min-h-36 resize-y"
                id="contact-details"
                name="message"
                minlength="20"
                required
                aria-describedby="contact-details-error"
                data-validate
              ></textarea>
              <p class="contact-error" id="contact-details-error" aria-live="polite"></p>
            </div>

            <div class="sm:col-span-2">
              <label
                class="flex cursor-pointer items-start gap-4 text-sm leading-6 text-ink-muted"
                for="contact-consent"
              >
                <input
                  class="mt-1 size-4 shrink-0 accent-[var(--brand-color-ink)]"
                  id="contact-consent"
                  name="consent"
                  type="checkbox"
                  value="agreed"
                  required
                  aria-describedby="contact-consent-error"
                  data-validate
                />
                <span>
                  I agree that the studio may use these details to respond to my inquiry via
                  WhatsApp or another contact method. <span aria-hidden="true">*</span>
                </span>
              </label>
              <p class="contact-error" id="contact-consent-error" aria-live="polite"></p>
            </div>
          </div>

          <div class="mt-9">
            <button
              type="submit"
              class="inline-flex min-h-12 items-center justify-center gap-4 border border-ink bg-ink px-7 py-3 text-[0.68rem] font-bold tracking-[0.14em] text-light uppercase transition-colors hover:bg-accent hover:text-ink disabled:cursor-not-allowed disabled:border-ink/25 disabled:bg-ink/20 disabled:text-ink/45"
              disabled={!contact.whatsappUrl}
            >
              <span>Send via WhatsApp</span>
              <span aria-hidden="true">→</span>
            </button>
          </div>

          <div
            class:list={[
              'mt-7 border px-5 py-4 text-sm leading-6',
              contact.whatsappUrl
                ? 'hidden border-ink/20 text-ink-muted'
                : 'border-ink/25 text-ink-muted',
            ]}
            role="status"
            aria-live="polite"
            data-form-status
          >
            {!contact.whatsappUrl && (
              <span>
                WhatsApp submission is currently unavailable. Please email{' '}
                <a class="underline underline-offset-4" href={primaryEmail.href}>
                  {primaryEmail.address}
                </a>
                .
              </span>
            )}
          </div>
        </form>
      </div>
    </div>
  </Container>
</Section>

<script>
  type ContactField = HTMLInputElement | HTMLTextAreaElement;

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const fields = [...form.querySelectorAll<ContactField>('[data-validate]')];
    const status = form.querySelector<HTMLElement>('[data-form-status]');

    const setStatus = (message: string, state: 'idle' | 'loading' | 'success' | 'error') => {
      if (!status) return;
      status.textContent = message;
      status.classList.remove(
        'hidden',
        'border-ink/20',
        'border-red-800/40',
        'border-emerald-800/40',
      );
      status.classList.add(
        state === 'error'
          ? 'border-red-800/40'
          : state === 'success'
            ? 'border-emerald-800/40'
            : 'border-ink/20',
      );
    };

    const getValidationMessage = (field: ContactField) => {
      if (field.validity.valueMissing) {
        return field.type === 'checkbox'
          ? 'Please confirm consent before sending.'
          : 'This field is required.';
      }
      if (field.validity.typeMismatch) return 'Please enter a valid email address.';
      if (field.validity.tooShort) {
        const minimum =
          field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement
            ? field.minLength
            : 0;
        return field instanceof HTMLTextAreaElement
          ? `Please provide at least ${minimum} characters.`
          : `Please enter at least ${minimum} characters.`;
      }
      return '';
    };

    const validateField = (field: ContactField) => {
      const message = getValidationMessage(field);
      const error = document.getElementById(`${field.id}-error`);
      field.setAttribute('aria-invalid', String(Boolean(message)));
      if (error) error.textContent = message;
      return !message;
    };

    for (const field of fields) {
      field.addEventListener('blur', () => validateField(field));
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') === 'true') validateField(field);
      });
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const invalidField = fields.find((field) => !validateField(field));
      if (invalidField) {
        invalidField.focus();
        setStatus('Please review the highlighted fields and try again.', 'error');
        return;
      }

      const whatsappBaseUrl = form.dataset.whatsappUrl ?? '';
      if (!whatsappBaseUrl) {
        setStatus('WhatsApp submission is unavailable. Please use the direct email link.', 'error');
        return;
      }

      const formData = new FormData(form);
      const value = (name: string) => String(formData.get(name) ?? '').trim();
      const projectLocation = value('projectLocation');
      const message = [
        form.dataset.messageHeading ?? 'New Project Inquiry',
        '',
        `Name: ${value('name')}`,
        `Phone: ${value('phone')}`,
        `Email: ${value('email')}`,
        ...(projectLocation ? [`Project Location: ${projectLocation}`] : []),
        '',
        'Project Details:',
        value('message'),
      ].join('\n');

      const whatsappUrl = new URL(whatsappBaseUrl);
      whatsappUrl.searchParams.set('text', message);

      setStatus(
        'WhatsApp is opening with your project details. Review the message, then tap Send.',
        'success',
      );

      const whatsappLink = document.createElement('a');
      whatsappLink.href = whatsappUrl.toString();
      whatsappLink.target = '_blank';
      whatsappLink.rel = 'noopener noreferrer';
      whatsappLink.click();
    });
  }
</script>

<style>
  .contact-label {
    display: block;
    margin-bottom: 0.65rem;
    color: var(--brand-color-ink);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .contact-control {
    width: 100%;
    min-height: 3.25rem;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--brand-color-ink) 32%, transparent);
    border-radius: 0;
    background: transparent;
    color: var(--brand-color-ink);
    padding: 0.7rem 0.15rem;
    outline: none;
    transition: border-color var(--brand-duration-base) var(--brand-ease-standard);
  }

  .contact-control:focus {
    border-color: var(--brand-color-ink);
    box-shadow: 0 2px 0 var(--brand-color-ink);
  }

  .contact-control[aria-invalid='true'] {
    border-color: #8c2f2f;
  }

  .contact-error {
    min-height: 1.25rem;
    margin-top: 0.4rem;
    color: #7a2525;
    font-size: 0.72rem;
    line-height: 1.4;
  }
</style>

---
import type { ContactConfig } from '../../data/contact';
import ContactIcon from './ContactIcon.astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';

interface Props {
  contact: ContactConfig;
}

const { contact } = Astro.props;
const primaryPhone = contact.phones.find((phone) => phone.isPrimary)!;
const primaryEmail = contact.emails.find((email) => email.isPrimary)!;
---

<Section labelledby="contact-cta-title">
  <Container width="wide">
    <div class="grid gap-12 border-y border-border py-[clamp(3rem,7vw,6rem)] lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p class="eyebrow">Begin the Conversation</p>
        <h2
          id="contact-cta-title"
          class="mt-6 max-w-[12ch] font-display text-[clamp(3.6rem,6.8vw,8rem)] leading-[0.84] tracking-[-0.05em]"
        >
          Ready to Shape Something <span class="text-accent italic">Remarkable?</span>
        </h2>
        <p class="mt-8 max-w-[40rem] text-base leading-8 text-muted sm:text-lg">
          Tell us about the space you want to create, and our studio will guide the next
          conversation.
        </p>
      </div>

      <div class="flex flex-col gap-4 lg:col-span-4 lg:items-end">
        <a
          href={primaryPhone.href}
          class="inline-flex min-h-12 w-full items-center justify-between border border-accent bg-accent px-6 py-3 text-[0.68rem] font-bold tracking-[0.14em] text-ink uppercase transition-colors hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent lg:max-w-80"
        >
          Call {primaryPhone.display} <ContactIcon name="phone" class="size-4" />
        </a>
        <a
          href={primaryEmail.href}
          class="inline-flex min-h-12 w-full items-center justify-between border border-border px-6 py-3 text-[0.68rem] font-bold tracking-[0.14em] uppercase transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent lg:max-w-80"
        >
          Email the Studio <ContactIcon name="email" class="size-4" />
        </a>
      </div>
    </div>
  </Container>
</Section>

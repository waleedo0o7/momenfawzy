---
import type { ContactConfig } from '../../data/contact';
import ContactIcon from './ContactIcon.astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';

interface Props {
  contact: ContactConfig;
}

const { contact } = Astro.props;
---

<Section labelledby="contact-departments-title" class="border-b border-border">
  <Container width="wide">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <header class="lg:col-span-5">
        <p class="eyebrow">Department Directory</p>
        <h2
          id="contact-departments-title"
          class="mt-6 max-w-[10ch] font-display text-[clamp(3.5rem,5.8vw,6.8rem)] leading-[0.86] tracking-[-0.047em]"
        >
          Connect With the <span class="text-accent italic">Right Team.</span>
        </h2>
      </header>

      <div class="border-t border-border lg:col-span-7">
        {contact.emails.map((email, index) => (
          <a
            href={email.href}
            class="group grid min-h-24 grid-cols-[2.5rem_1fr_auto] items-center gap-4 border-b border-border py-5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:grid-cols-[3rem_12rem_1fr_auto]"
          >
            <span class="text-[0.62rem] tracking-[0.16em] text-muted">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="text-xs font-bold tracking-[0.13em] text-white/74 uppercase">
              {email.department}
            </span>
            <span class="col-span-2 break-all font-display text-[clamp(1.3rem,2vw,2rem)] leading-tight text-white/90 transition-colors group-hover:text-accent sm:col-span-1">
              {email.address}
            </span>
            <ContactIcon
              name="email"
              class="size-5 text-accent transition-transform group-hover:translate-x-1"
            />
          </a>
        ))}
      </div>
    </div>
  </Container>
</Section>

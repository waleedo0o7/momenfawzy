---
type IconName =
  | 'phone'
  | 'mobile'
  | 'email'
  | 'location'
  | 'map'
  | 'facebook'
  | 'instagram'
  | 'youtube'
  | 'whatsapp'
  | 'external';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'phone' && (
    <path d="M7.4 3.5 9.8 7l-1.7 2.1a15.3 15.3 0 0 0 6.8 6.8l2.1-1.7 3.5 2.4-.8 3.1c-.2.8-1 1.3-1.8 1.2C10 20 4 14 3.1 6.1 3 5.3 3.5 4.5 4.3 4.3l3.1-.8Z" />
  )}
  {name === 'mobile' && (
    <>
      <rect x="7" y="2" width="10" height="20" rx="2"></rect>
      <path d="M10 5h4M11 19h2"></path>
    </>
  )}
  {name === 'email' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="1"></rect>
      <path d="m4 7 8 6 8-6"></path>
    </>
  )}
  {name === 'location' && (
    <>
      <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
      <circle cx="12" cy="10" r="2.5"></circle>
    </>
  )}
  {name === 'map' && (
    <>
      <path d="m3 6 5-3 8 3 5-3v15l-5 3-8-3-5 3V6Z"></path>
      <path d="M8 3v15M16 6v15"></path>
    </>
  )}
  {name === 'facebook' && (
    <path d="M14 8h3V4h-3c-3 0-5 2-5 5v3H6v4h3v6h4v-6h3l1-4h-4V9c0-.7.3-1 1-1Z" />
  )}
  {name === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5"></rect>
      <circle cx="12" cy="12" r="4"></circle>
      <circle cx="17.5" cy="6.5" r=".75" fill="currentColor" stroke="none"></circle>
    </>
  )}
  {name === 'youtube' && (
    <>
      <path d="M21 12c0 3-.4 5-.8 5.7-.4.7-1 1-1.8 1.2-1.6.4-4 .4-6.4.4s-4.8 0-6.4-.4c-.8-.2-1.4-.5-1.8-1.2C3.4 17 3 15 3 12s.4-5 .8-5.7c.4-.7 1-1 1.8-1.2 1.6-.4 4-.4 6.4-.4s4.8 0 6.4.4c.8.2 1.4.5 1.8 1.2.4.7.8 2.7.8 5.7Z"></path>
      <path d="m10 9 5 3-5 3V9Z"></path>
    </>
  )}
  {name === 'whatsapp' && (
    <>
      <path d="M20.5 11.6a8.5 8.5 0 0 1-12.7 7.5L3 20.5l1.3-4.6a8.5 8.5 0 1 1 16.2-4.3Z"></path>
      <path d="M8.1 7.4c.2-.5.4-.5.8-.5h.4c.2 0 .4.1.5.4l.9 2.1c.1.3.1.5-.1.7l-.7.9c-.2.2-.1.4 0 .6.5.9 1.3 1.7 2.2 2.2.2.1.4.2.6 0l.9-1.1c.2-.2.4-.3.7-.2l2.1 1c.3.1.4.3.4.5 0 .5-.2 1.5-.7 2-.5.5-1.3.8-2.1.6-1.1-.2-2.8-.8-4.6-2.4-1.5-1.4-2.6-3.1-2.9-4.3-.3-1.1 0-2 .4-2.5.3-.3.7-.5 1.2-.5"></path>
    </>
  )}
  {name === 'external' && (
    <>
      <path d="M14 4h6v6M20 4l-9 9"></path>
      <path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6"></path>
    </>
  )}
</svg>

---
import logo from '../../assets/brand/mf-logo-wide-white.svg';

interface Props {
  size?: 'header' | 'footer' | 'contactTree';
  class?: string;
  priority?: boolean;
}

const { size = 'header', class: className, priority = false } = Astro.props;
const sizeClasses = {
  header: 'w-[9.25rem] sm:w-[10.5rem]',
  footer: 'w-[12.5rem] sm:w-[13.75rem]',
  contactTree: 'w-[11.5rem] sm:w-[13rem]',
};
---

<img
  src={logo.src}
  width={1013}
  height={284}
  alt="Momen Fawzy Interior Design Studio"
  class:list={['block h-auto max-w-full', sizeClasses[size], className]}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
  draggable="false"
/>
